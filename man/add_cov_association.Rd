\item \code{linear(COV, THETA, ref=)}: \eqn{1 + \theta (COV - ref)}
\item \code{power(COV, THETA, ref=)}: \eqn{(COV / ref)^\theta} (allometric)
\item \code{exponential(COV, THETA, ref=)}: \eqn{e^{\theta (COV - ref)}}
